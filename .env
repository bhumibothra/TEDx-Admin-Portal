# Public-safe environment template for public GitHub upload
# Replace these values with your real ones locally and keep them out of version control.

NEXT_PUBLIC_APP_NAME=TEDx Admin Portal
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_ENVIRONMENT=production

# If your project uses Vite instead of Next.js, use:
# VITE_APP_NAME=TEDx Admin Portal
# VITE_API_URL=https://api.example.com
